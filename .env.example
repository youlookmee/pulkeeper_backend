# ===========================
# 🔐 OpenAI API (OCR / AI)
# ===========================
OPENAI_API_KEY=your_openai_key_here


# ===========================
# 🗄 PostgreSQL Database
# ===========================
# Railway предоставляет URL автоматически вида:
# postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://user:password@host:5432/dbname


# ===========================
# 🌍 Environment
# development / production
# ===========================
ENV=development
